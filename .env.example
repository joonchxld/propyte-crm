# =====================================================================
# PROPYTE CRM — Variables de entorno
# Actualizado 2026-06-11 (rebuild F1-F6 + Personalización P1-P3 + Conectividad C1-C3)
#
# DÓNDE VA CADA COSA:
#   · Local (.env): todas — para dev y scripts/ops
#   · Hostinger (env del panel): todas las de PRODUCCIÓN (marcadas [PROD])
#   · NUNCA commitear .env ni poner secrets en el cliente
# =====================================================================

# ---------------------------------------------------------------------
# Base de datos [PROD]
# Supabase compartida oaijxdpevakashxshhvm, esquema propyte_crm.
# Session Pooler aws-1, puerto 5432 (memoria: sin IPv4 addon).
# ---------------------------------------------------------------------
# El <PROJECT_REF> es el identificador del proyecto Supabase; sale del panel. No se deja
# escrito aquí porque este archivo SÍ está en el repositorio (ver .gitignore): identifica
# el endpoint exacto de la base de producción y no hay razón para publicarlo.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Password de la BD (la usan scripts/ops locales tipo apply-sql)
# Panel: https://supabase.com/dashboard/project/<PROJECT_REF>/settings/database
SUPABASE_DB_PASSWORD=""

# ---------------------------------------------------------------------
# NextAuth [PROD]
# Producción: NEXTAUTH_URL=https://crm.propyte.com
# Generar secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# URL pública del CRM. Los webhooks de Twilio la usan para armar las URLs de callback y
# validar la firma. Producción: https://crm.propyte.com (sin barra final).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------
# WhatsApp — provider intercambiable [PROD]
# Propyte usa META Cloud API directo para WhatsApp (decisión 2026-06-11). Twilio se usa
# SOLO para llamadas y SMS (sección Twilio más abajo), nunca para WhatsApp.
# WHATSAPP_PROVIDER: déjalo en meta_cloud. El driver twilio existe en el código pero NO se
# usa (no soporta BSUID, #829).
# ---------------------------------------------------------------------
WHATSAPP_PROVIDER="meta_cloud"

# Meta WhatsApp Cloud API (Business Manager → WhatsApp → API Setup):
#   META_WA_PHONE_NUMBER_ID: "Phone number ID" del número registrado en la WABA
#   META_WA_ACCESS_TOKEN: token PERMANENTE de system user con permiso whatsapp_business_messaging
#   META_WA_VERIFY_TOKEN: lo inventas tú; se pega igual al suscribir el webhook
#   META_WA_APP_SECRET: App Secret de la app (valida firma del webhook; recomendado en prod)
# Webhook (developers.facebook.com → app → WhatsApp → Configuration → campo "messages"):
#   https://crm.propyte.com/api/webhooks/whatsapp/meta
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_VERIFY_TOKEN=""
META_WA_APP_SECRET=""

# --- Instagram DM + Facebook Messenger (webhook de mensajes directos y comentarios) ---
# Estas dos FALTABAN en este archivo, que es la única guía de qué configurar en un
# despliegue nuevo. Y la segunda dejó de ser opcional con el PR #59 (#754).
#   META_DM_VERIFY_TOKEN: lo inventas tú; se pega igual al suscribir el webhook.
#   META_DM_APP_SECRET: App Secret de la app. 🚨 OBLIGATORIA EN PROD.
#     Desde el #754 el webhook FALLA CERRADO: sin esta variable responde 401 a Meta y la
#     ingesta de DM SE DETIENE (antes aceptaba sin verificar, que era el agujero — la URL
#     está publicada en el código y cualquiera podía inyectar mensajes falsos). Si dejan de
#     entrar DM tras un despliegue, revisa esta variable primero: el rechazo queda escrito
#     en los registros nombrándola.
#     Se pone a mano en hPanel y EXIGE reiniciar Passenger — ver
#     docs/superpowers/specs/2026-07-10-ig-messenger-multicuenta-design.md:106
# Webhook (developers.facebook.com → app → Webhooks, objetos `instagram` y `page`,
# campos `messages` y `comments`/`feed`):
#   https://crm.propyte.com/api/webhooks/meta-dm
META_DM_VERIFY_TOKEN=""
META_DM_APP_SECRET=""

# ---------------------------------------------------------------------
# Twilio — LLAMADAS (Voice) y SMS [PROD]
# Twilio NO se usa para WhatsApp: WhatsApp va por Meta Cloud API (ver arriba).
# Sin estas variables el CRM funciona; la voz se degrada (isVoiceConfigured() = false)
# y el envío de SMS lanza error claro. Se ponen a mano en hPanel y EXIGEN reiniciar
# Passenger. Panel: https://console.twilio.com
#   TWILIO_ACCOUNT_SID:   Account SID (empieza con AC…). Console → Account Info.
#   TWILIO_AUTH_TOKEN:    Auth Token. Además de autenticar, VALIDA LA FIRMA de todos los
#                         webhooks de Twilio (voz y SMS): sin él responden 403.
#   TWILIO_PHONE_NUMBER:  número Twilio en E.164 (+52…) con capacidad Voice + SMS.
#                         Es el From de los SMS y el callerId de las llamadas salientes.
#   TWILIO_TWIML_APP_SID: SID de la TwiML App (empieza con AP…). Su Voice Request URL debe
#                         ser https://crm.propyte.com/api/webhooks/twilio/voice/twiml
#                         (método POST). Obligatoria para llamar desde el navegador.
#   TWILIO_API_KEY_SID / TWILIO_API_KEY_SECRET: API Key (SK…) para firmar el token de voz
#                         del navegador. Recomendado en prod; si faltan, el código cae a
#                         ACCOUNT_SID + AUTH_TOKEN (funciona, pero expone el token principal).
#                         El secret solo se muestra UNA vez al crearla.
# Webhooks a configurar en Twilio (todos POST):
#   Número → Voice, "A call comes in": https://crm.propyte.com/api/webhooks/twilio/voice/incoming
#   Número → Messaging, "A message comes in": https://crm.propyte.com/api/webhooks/twilio/sms
#   El status de llamadas y las grabaciones los fija el propio código con NEXT_PUBLIC_APP_URL.
# 🚨 NEXT_PUBLIC_APP_URL (arriba) debe ser EXACTAMENTE https://crm.propyte.com, sin barra
#    final: se usa para reconstruir la URL contra la que se valida la firma. Si no coincide
#    con la que Twilio llama, TODOS los webhooks de Twilio dan 403 "Firma inválida".
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_TWIML_APP_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_MESSAGING_SERVICE_SID=""

# ---------------------------------------------------------------------
# Motor de workflows + conectores (cron) [PROD]
# Protege /api/cron/workflows (cada 1 min) y /api/cron/connectors/tiktok (cada 5 min).
# Cron Hostinger: curl -s -H "x-cron-secret: $CRON_SECRET" https://crm.propyte.com/api/cron/workflows
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------
# Intake de leads — webhook web v2 [PROD]
# Header X-Webhook-Secret que manda propyte.com al POST /api/webhooks/leads.
# (Alternativa recomendada: crear conector WEBSITE en Admin→Integraciones con su propio secret.)
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------
LEADS_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------
# Hub — inventario (catálogo SOT). Lectura = SQL directo a real_estate_hub
# por la MISMA conexión (DATABASE_URL); no requiere URL/key.
# Mutación de inventario (hold/release/confirm) = REST al Hub:
#   HUB_API_BASE_URL = https://hub.propyte.com
#   HUB_API_KEY      = mismo valor que HUB_INTERNAL_API_KEY del Hub (header x-hub-api-key)
# HUB_WEBHOOK_SECRET valida el webhook entrante Hub→CRM (/api/webhooks/hub-unit, header x-hub-secret)
# ---------------------------------------------------------------------
HUB_API_BASE_URL=""
HUB_API_KEY=""
HUB_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------
# IA — bot del inbox + agentes (SDR/Calificador) + borradores [PROD]
# Sin la key: el CRM funciona completo; lo de IA se salta con nota (no truena).
# BOT_MODEL es opcional (default claude-sonnet-5). Admitidos: claude-sonnet-5,
# claude-sonnet-4-6, claude-haiku-4-5 — la lista vive en src/lib/bot/model.ts, y un valor
# fuera de ella se descarta con aviso y se usa el default (no tumba al bot).
# Ojo con dejarla declarada y VACÍA (BOT_MODEL=): antes eso mandaba el modelo en blanco a
# la API y cada corrida de agente devolvía 400. Hoy cae al default, pero mejor comentarla.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# BOT_MODEL="claude-sonnet-4-6"

# ---------------------------------------------------------------------
# Cifrado de PII [PROD]
# Cifra: expedientes KYC (documentNumber/taxId) y credenciales de conectores
# (tokens Meta/TikTok/portales). 32 bytes base64. SI SE PIERDE, lo cifrado es
# irrecuperable — guárdala también en el vault.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------
KYC_ENCRYPTION_KEY=""


# ---------------------------------------------------------------------
# Google Workspace / Gmail (GW-0 OAuth + GW-1 Gmail) [PROD]
# Requiere un cliente OAuth tipo "Aplicación web" (NO Desktop) en GCP proyecto PROPYTE:
#   APIs y servicios → Credenciales → Crear credenciales → ID de cliente OAuth → Aplicación web.
#   Habilitar Gmail API. Pantalla de consentimiento: Internal (org Workspace) con scopes
#   gmail.readonly + gmail.send.
# El redirect del cliente Web debe ser IDÉNTICO a GOOGLE_REDIRECT_URI.
# Para pruebas locales además registra http://localhost:3001/api/google/oauth/callback
# Cifrado de tokens (32 bytes base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.propyte.com/api/google/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Transactional email (Hostinger SMTP) [PROD]
# Puerto 465 = SSL/TLS (secure:true). SMTP_FROM debe coincidir con el buzón autenticado.
# Generar buzón: Hostinger → Hosting → Emails → Crear cuenta.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Propyte CRM <noreply@propyte.com>

# ---------------------------------------------------------------------
# MCP admin server (stdio wrapper propyte-crm-mcp) [PROD]
# Generar: openssl rand -hex 32
# ---------------------------------------------------------------------
CRM_MCP_API_TOKEN=

# Credencial de SOLO LECTURA de la misma pasarela: solo autoriza GET, y cualquier
# POST/PATCH/PUT con ella responde 403. Es la que deben portar los consumidores que
# únicamente consultan (el tablero de mejoras). Opcional: sin valor, nadie tiene acceso
# de lectura separado y todo sigue como antes.
# 🚨 NO la pongas igual a CRM_MCP_API_TOKEN: si coinciden se ignora, a propósito.
CRM_MCP_READONLY_TOKEN=

# =====================================================================
# NOTAS — lo que NO va aquí:
#   · Credenciales de Meta/TikTok/portales (pageId, tokens, pixelId, capiAccessToken):
#     se capturan en Admin → Integraciones → Conectores y se guardan CIFRADAS en BD.
#   · Zoho, Meta Ads dashboards, Drive, Banxico, robots: viven en Propyte_hub.
#   · Resend NO se usa — email transaccional via Nodemailer + SMTP Hostinger (ver sección arriba).
# =====================================================================
