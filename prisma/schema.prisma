// =====================================================================
// REBUILD F6 — Cotizador y cobranza (consolidado §2.3 items 4-8, Anexo §C.2)
// =====================================================================

enum QuoteStatus {
  DRAFT
  SENT
  OPENED
  ACCEPTED
  EXPIRED
  CANCELLED

  @@schema("propyte_crm")
}

enum PaymentScheme {
  CONTADO
  FINANCIAMIENTO_DIRECTO
  CREDITO_BANCARIO
  MIXTO

  @@schema("propyte_crm")
}

enum InstallmentStatus {
  PENDIENTE
  PAGADA
  VENCIDA
  CONDONADA

  @@schema("propyte_crm")
}

enum DealDocumentType {
  KYC
  CONTRATO_ENVIADO
  CONTRATO_FIRMADO
  COMPROBANTE_ENGANCHE
  RECIBO
  COMPROBANTE_DOMICILIO
  OTRO

  @@schema("propyte_crm")
}

// Cotización como entidad (paridad Zoho "Cotizaciones"). unitSnapshot congela
// precio del Hub + FX al momento de cotizar (data-gate + multimoneda §2.4)
model Quote {
  id          String @id @default(uuid())
  dealId      String
  deal        Deal   @relation(fields: [dealId], references: [id])
  createdById String
  createdBy   User   @relation("QuotesCreated", fields: [createdById], references: [id])

  hubUnitId    String?
  unitSnapshot Json          @default("{}")
  currency     Currency      @default(MXN)
  listPrice    Decimal       @db.Decimal(14, 2)
  discountPct  Decimal       @default(0) @db.Decimal(5, 2)
  finalPrice   Decimal       @db.Decimal(14, 2)
  fxRate       Decimal?      @db.Decimal(10, 4)
  scheme       PaymentScheme
  status       QuoteStatus   @default(DRAFT)
  pdfUrl       String?
  sentAt       DateTime?
  openedAt     DateTime?
  expiresAt    DateTime?
  notes        String?       @db.Text

  paymentPlan PaymentPlan?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dealId])
  @@map("quotes")
  @@schema("propyte_crm")
}

model PaymentPlan {
  id      String @id @default(uuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id])

  downPaymentPct     Decimal @db.Decimal(5, 2)
  downPaymentAmount  Decimal @db.Decimal(14, 2)
  monthsCount        Int     @default(0)
  monthlyAmount      Decimal @default(0) @db.Decimal(14, 2)
  deliveryPaymentPct Decimal @default(0) @db.Decimal(5, 2)
  deliveryAmount     Decimal @default(0) @db.Decimal(14, 2)

  schedules PaymentSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_plans")
  @@schema("propyte_crm")
}

model PaymentSchedule {
  id     String      @id @default(uuid())
  planId String
  plan   PaymentPlan @relation(fields: [planId], references: [id])

  number     Int
  dueDate    DateTime
  amount     Decimal           @db.Decimal(14, 2)
  status     InstallmentStatus @default(PENDIENTE)
  paidAt     DateTime?
  paidAmount Decimal?          @db.Decimal(14, 2)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, number])
  @@index([status, dueDate])
  @@map("payment_schedules")
  @@schema("propyte_crm")
}

// Documentación del negocio (KYC, contratos, comprobantes — Zoho §2.3.6)
model DealDocument {
  id           String           @id @default(uuid())
  dealId       String
  deal         Deal             @relation(fields: [dealId], references: [id])
  type         DealDocumentType
  name         String
  url          String
  uploadedById String
  uploadedBy   User             @relation("DealDocsUploaded", fields: [uploadedById], references: [id])
  verifiedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dealId])
  @@map("deal_documents")
  @@schema("propyte_crm")
}

// Broker externo asociado + split (Zoho "Broker Asociado", §2.3.7)
model ExternalBroker {
  id       String  @id @default(uuid())
  name     String
  agency   String?
  phone    String?
  email    String?
  splitPct Decimal @default(50) @db.Decimal(5, 2)
  isActive Boolean @default(true)
  notes    String? @db.Text

  deals Deal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("external_brokers")
  @@schema("propyte_crm")
}

// =====================================================================
// PERSONALIZACIÓN & EQUIPOS — P1 Equipos/Territorios (speckit §2)
// =====================================================================

enum TeamRole {
  LEADER
  SENIOR
  JUNIOR
  HOSTESS

  @@schema("propyte_crm")
}

enum TerritoryType {
  GEO
  SEGMENT

  @@schema("propyte_crm")
}

enum TerritoryAccess {
  VIEW
  EDIT

  @@schema("propyte_crm")
}

// Capa matricial ENCIMA de la jerarquía de roles RH (User.teamLeaderId NO se duplica)
model Team {
  id                String  @id @default(uuid())
  name              String  @unique
  plaza             Plaza
  leaderId          String?
  leader            User?   @relation("TeamLeader", fields: [leaderId], references: [id])
  parentTeamId      String?
  parentTeam        Team?   @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams        Team[]  @relation("TeamHierarchy")
  forecastManagerId String?
  forecastManager   User?   @relation("TeamForecast", fields: [forecastManagerId], references: [id])
  isActive          Boolean @default(true)

  members TeamMember[]
  goals   Goal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("teams")
  @@schema("propyte_crm")
}

// Membresía N:N con rol e historial (joinedAt/leftAt — nunca se borra)
model TeamMember {
  id         String    @id @default(uuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  roleInTeam TeamRole  @default(JUNIOR)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  @@index([teamId, leftAt])
  @@index([userId, leftAt])
  @@map("team_members")
  @@schema("propyte_crm")
}

// Territorio = matriz de asignación/visibilidad (distinta a jerarquía RH). Zona dentro de plaza (OQ2).
model Territory {
  id                String        @id @default(uuid())
  name              String        @unique
  type              TerritoryType @default(GEO)
  parentTerritoryId String?
  parentTerritory   Territory?    @relation("TerritoryHierarchy", fields: [parentTerritoryId], references: [id])
  childTerritories  Territory[]   @relation("TerritoryHierarchy")
  plaza             Plaza?
  zones             String[]      @default([])
  forecastManagerId String?
  forecastManager   User?         @relation("TerritoryForecast", fields: [forecastManagerId], references: [id])
  isActive          Boolean       @default(true)

  members TerritoryMember[]
  rules   TerritoryRule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("territories")
  @@schema("propyte_crm")
}

model TerritoryMember {
  id          String          @id @default(uuid())
  territoryId String
  territory   Territory       @relation(fields: [territoryId], references: [id])
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  accessLevel TerritoryAccess @default(VIEW)

  createdAt DateTime @default(now())

  @@unique([territoryId, userId])
  @@map("territory_members")
  @@schema("propyte_crm")
}

// Regla de asignación a territorio (conditions = DSL del Anexo D.4 sobre contact); hijo antes que padre
model TerritoryRule {
  id          String    @id @default(uuid())
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])
  priority    Int       @default(100)
  conditions  Json      @default("{}")
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
  @@map("territory_rules")
  @@schema("propyte_crm")
}

// =====================================================================
// PERSONALIZACIÓN — P2 Registro de metadata (speckit §3)
// =====================================================================

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  PERCENT
  DATE
  DATETIME
  BOOLEAN
  EMAIL
  PHONE
  URL
  PICKLIST
  MULTI_PICKLIST
  AUTO_NUMBER
  FORMULA
  FILE
  USER
  LOOKUP
  MASTER_DETAIL
  ROLLUP
  GEO

  @@schema("propyte_crm")
}

enum FieldAccess {
  HIDDEN
  READ
  EDIT

  @@schema("propyte_crm")
}

// Objetos del CRM (núcleo isSystem; Hub isExternal=read-only — decisión OQ5)
model CustomObjectDef {
  id              String  @id @default(uuid())
  apiName         String  @unique // INMUTABLE (lección HubSpot)
  label           String
  pluralLabel     String
  icon            String?
  isSystem        Boolean @default(false)
  isExternal      Boolean @default(false)
  recordNameField String  @default("name")
  isActive        Boolean @default(true)

  fields  CustomFieldDef[]
  layouts Layout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("custom_objects")
  @@schema("propyte_crm")
}

// Definición de campo. isSystem=true documenta columnas tipadas reales; custom vive en JSONB.
model CustomFieldDef {
  id            String          @id @default(uuid())
  objectApiName String
  object        CustomObjectDef @relation(fields: [objectApiName], references: [apiName])
  apiName       String // INMUTABLE tras crear; convención obj_snake
  label         String
  fieldType     FieldType // INMUTABLE tras crear
  isRequired    Boolean         @default(false)
  isUnique      Boolean         @default(false)
  isSearchable  Boolean         @default(false)
  defaultValue  Json?
  helpText      String?
  validation    Json            @default("{}")
  order         Int             @default(100)
  isSystem      Boolean         @default(false)
  isActive      Boolean         @default(true)
  archivedAt    DateTime? // archivar conserva valores (PC6)

  options     FieldOption[]
  permissions FieldPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([objectApiName, apiName])
  @@map("custom_fields")
  @@schema("propyte_crm")
}

model FieldOption {
  id       String         @id @default(uuid())
  fieldId  String
  field    CustomFieldDef @relation(fields: [fieldId], references: [id])
  value    String
  label    String
  color    String?
  order    Int            @default(100)
  isActive Boolean        @default(true) // nunca borrar opción en uso → desactivar

  @@unique([fieldId, value])
  @@map("field_options")
  @@schema("propyte_crm")
}

model Layout {
  id            String          @id @default(uuid())
  objectApiName String
  object        CustomObjectDef @relation(fields: [objectApiName], references: [apiName])
  name          String          @default("Default")
  isDefault     Boolean         @default(true)

  sections LayoutSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([objectApiName, name])
  @@map("layouts")
  @@schema("propyte_crm")
}

model LayoutSection {
  id         String @id @default(uuid())
  layoutId   String
  layout     Layout @relation(fields: [layoutId], references: [id])
  title      String
  order      Int    @default(100)
  columns    Int    @default(2)
  conditions Json? // DSL Anexo D.4: mostrar/ocultar sección

  fields LayoutField[]

  @@map("layout_sections")
  @@schema("propyte_crm")
}

model LayoutField {
  id           String        @id @default(uuid())
  sectionId    String
  section      LayoutSection @relation(fields: [sectionId], references: [id])
  fieldApiName String
  order        Int           @default(100)
  conditions   Json? // DSL: mostrar/ocultar/forzar-obligatorio (OQ6: v1)

  @@map("layout_fields")
  @@schema("propyte_crm")
}

// Field-level security por rol (PC5: restrictivo por defecto)
model FieldPermission {
  id      String         @id @default(uuid())
  fieldId String
  field   CustomFieldDef @relation(fields: [fieldId], references: [id])
  role    UserRole
  access  FieldAccess    @default(READ)

  @@unique([fieldId, role])
  @@map("field_permissions")
  @@schema("propyte_crm")
}

// Field-level security para campos CORE (columnas Prisma, no custom).
// object = "contact" | "deal"; fieldKey = nombre de la columna (ej. "budgetMin").
// Ausencia de fila = acceso por defecto EDIT (no restrictivo) para no romper el flujo actual.
model CoreFieldPermission {
  id       String      @id @default(uuid())
  object   String
  fieldKey String
  role     UserRole
  access   FieldAccess @default(EDIT)

  @@unique([object, fieldKey, role])
  @@map("core_field_permissions")
  @@schema("propyte_crm")
}

// Vistas guardadas (Fase 5, T5.4): filtros/columnas por módulo y usuario.
// ownerId sin relación explícita para no tocar el modelo User.
model SavedView {
  id        String   @id @default(uuid())
  name      String
  module    String // "contacts" | "pipeline" | "quotes"
  ownerId   String
  filters   Json     @default("{}")
  scope     String   @default("personal") // personal | team | org
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([module, ownerId])
  @@map("saved_views")
  @@schema("propyte_crm")
}

// =====================================================================
// PERSONALIZACIÓN — P3 Relaciones entre módulos (speckit §4)
// =====================================================================

enum RelationshipKind {
  LOOKUP
  MASTER_DETAIL
  MANY_TO_MANY

  @@schema("propyte_crm")
}

enum OnDeleteBehavior {
  SET_NULL
  CASCADE
  RESTRICT

  @@schema("propyte_crm")
}

enum RollupAggregate {
  COUNT
  SUM
  MIN
  MAX
  AVG

  @@schema("propyte_crm")
}

model RelationshipDef {
  id               String           @id @default(uuid())
  name             String           @unique
  fromObject       String
  toObject         String
  kind             RelationshipKind
  onDelete         OnDeleteBehavior @default(SET_NULL)
  relatedListLabel String
  isRequired       Boolean          @default(false)
  allowMultiple    Boolean          @default(true)
  isActive         Boolean          @default(true)
  isSystem         Boolean          @default(false) // describe relaciones físicas Prisma existentes (speckit 4.4)

  labels      RelationshipLabel[]
  projections LookupProjection[]
  rollups     RollupFieldDef[]
  links       RecordLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("relationships")
  @@schema("propyte_crm")
}

// Rol del record en la relación (estilo HubSpot association labels)
model RelationshipLabel {
  id             String          @id @default(uuid())
  relationshipId String
  relationship   RelationshipDef @relation(fields: [relationshipId], references: [id])
  label          String
  fromRole       String?
  toRole         String?

  links RecordLink[]

  @@unique([relationshipId, label])
  @@map("relationship_labels")
  @@schema("propyte_crm")
}

// Field-of-lookup (estilo Zoho, máx 5 — se valida en API)
model LookupProjection {
  id                 String          @id @default(uuid())
  relationshipId     String
  relationship       RelationshipDef @relation(fields: [relationshipId], references: [id])
  sourceFieldApiName String
  displayLabel       String
  order              Int             @default(100)

  @@map("lookup_projections")
  @@schema("propyte_crm")
}

// Rollup (estilo Salesforce) — solo MASTER_DETAIL/FK fuerte; lo calcula el motor/cron
model RollupFieldDef {
  id                  String          @id @default(uuid())
  parentObject        String
  childRelationshipId String
  childRelationship   RelationshipDef @relation(fields: [childRelationshipId], references: [id])
  aggregate           RollupAggregate
  childFieldApiName   String?
  filter              Json?

  createdAt DateTime @default(now())

  @@map("rollup_fields")
  @@schema("propyte_crm")
}

// Puente N:N GENÉRICO con label/rol — evita DDL en runtime (PC1; desviación
// documentada del speckit 4.2 "tabla por relación": un solo puente indexado)
model RecordLink {
  id             String             @id @default(uuid())
  relationshipId String
  relationship   RelationshipDef    @relation(fields: [relationshipId], references: [id])
  fromObject     String
  fromId         String
  toObject       String
  toId           String
  labelId        String?
  label          RelationshipLabel? @relation(fields: [labelId], references: [id])
  createdById    String?

  createdAt DateTime @default(now())

  @@unique([relationshipId, fromId, toId])
  @@index([fromObject, fromId])
  @@index([toObject, toId])
  @@map("record_links")
  @@schema("propyte_crm")
}

// Records de objetos custom desde cero (P4 — tabla lista, editor después)
model CustomRecord {
  id            String  @id @default(uuid())
  objectApiName String
  recordName    String
  data          Json    @default("{}")
  createdById   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([objectApiName, deletedAt])
  @@map("custom_records")
  @@schema("propyte_crm")
}

// =====================================================================
// CONECTIVIDAD & CAPI — Speckit #4 (C1/C2)
// =====================================================================

enum ConnectorDirection {
  INBOUND
  OUTBOUND
  BOTH

  @@schema("propyte_crm")
}

enum ConversionEventName {
  LEAD
  QUALIFIED
  MEETING_SCHEDULED
  RESERVED
  WON

  @@schema("propyte_crm")
}

enum ConversionStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
  SKIPPED

  @@schema("propyte_crm")
}

// Log outbound de conversiones (speckit #4 §5.1). eventId UNIQUE = idempotencia
// (dedup interno y vs pixel). hashedPII se construye al despachar, nunca PII en claro.
model ConversionEvent {
  id              String              @id @default(uuid())
  contactId       String
  contact         Contact             @relation(fields: [contactId], references: [id])
  dealId          String?
  deal            Deal?               @relation(fields: [dealId], references: [id])
  eventName       ConversionEventName
  eventId         String              @unique
  occurredAt      DateTime            @default(now())
  value           Decimal?            @db.Decimal(14, 2)
  currency        Currency            @default(MXN)
  leadQualityTier String?
  clickIds        Json                @default("{}")
  platforms       String[]            @default([])
  status          ConversionStatus    @default(PENDING)
  attempts        Int                 @default(0)
  results         Json                @default("{}") // por plataforma: ok/emq/error
  lastError       String?             @db.Text
  sentAt          DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([contactId])
  @@map("conversion_events")
  @@schema("propyte_crm")
}

// =====================================================================
// AGENTES DE IA — Speckit #4 (C3): agente = empleado digital gobernado (PA1)
// =====================================================================

enum AgentType {
  PREBUILT
  CUSTOM

  @@schema("propyte_crm")
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  ESCALATED
  FAILED

  @@schema("propyte_crm")
}

// Identidad del agente = systemUserId (User con rol RBAC). allowedTools acota
// el registry de lib/agents/tools.ts. limits: horario, tope de pasos, etc.
model AgentDef {
  id            String        @id @default(uuid())
  name          String        @unique
  type          AgentType     @default(PREBUILT)
  systemUserId  String
  systemUser    User          @relation("AgentIdentity", fields: [systemUserId], references: [id])
  goal          String        @db.Text
  autonomyLevel AutonomyLevel @default(L2)
  allowedTools  String[]      @default([])
  trigger       Json          @default("{}")
  schedule      String?
  limits        Json          @default("{}")
  isActive      Boolean       @default(false)

  runs AgentRun[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("agents")
  @@schema("propyte_crm")
}

// Cada corrida: razonamiento + tool calls auditables (PA1: trazable como un humano)
model AgentRun {
  id                String         @id @default(uuid())
  agentId           String
  agent             AgentDef       @relation(fields: [agentId], references: [id])
  trigger           String
  input             Json           @default("{}")
  steps             Json           @default("[]")
  output            String?        @db.Text
  status            AgentRunStatus @default(RUNNING)
  escalatedToUserId String?
  error             String?        @db.Text
  startedAt         DateTime       @default(now())
  endedAt           DateTime?

  @@index([agentId, startedAt])
  @@map("agent_runs")
  @@schema("propyte_crm")
}

// =====================================================================
// SHORTLIST / PROPUESTA EXPRESS — feat/shortlist-propuesta-express
// =====================================================================

enum ShortlistStatus {
  DRAFT
  SENT
  OPENED

  @@schema("propyte_crm")
}

// Propuesta express: lista curada de unidades del Hub enviable por link público.
// El CRM NO posee inventario — solo refs hubUnitId + snapshot congelado (P1, §5.11.4).
model Shortlist {
  id          String          @id @default(uuid())
  token       String          @unique
  contactId   String
  contact     Contact         @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?           @relation(fields: [dealId], references: [id])
  createdById String
  createdBy   User            @relation("ShortlistsCreated", fields: [createdById], references: [id])
  title       String          @default("Propuesta de unidades")
  status      ShortlistStatus @default(DRAFT)
  sentAt      DateTime?
  openedAt    DateTime?
  expiresAt   DateTime?
  items       ShortlistItem[]
  views       ShortlistView[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([contactId])
  @@index([dealId])
  @@map("shortlists")
  @@schema("propyte_crm")
}

model ShortlistItem {
  id          String    @id @default(uuid())
  shortlistId String
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  hubUnitId   String
  snapshot    Json      @default("{}")
  note        String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([shortlistId])
  @@map("shortlist_items")
  @@schema("propyte_crm")
}

model ShortlistView {
  id          String    @id @default(uuid())
  shortlistId String
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  viewedAt    DateTime  @default(now())
  userAgent   String?

  @@index([shortlistId])
  @@map("shortlist_views")
  @@schema("propyte_crm")
}

// =====================================================================
// METAS / SCORECARD — §5.14
// =====================================================================

enum GoalScope {
  USER
  TEAM
  COMPANY

  @@schema("propyte_crm")
}

enum GoalMetric {
  CAPTACIONES
  NEGOCIOS_CREADOS
  COTIZACIONES_ENVIADAS
  ACTIVIDADES_COMPLETADAS
  NEGOCIOS_GANADOS
  MONTO_VENTA

  @@schema("propyte_crm")
}

// Metas mensuales por asesor/equipo/empresa (§5.14). El "real" se DERIVA, no se guarda.
model Goal {
  id          String     @id @default(uuid())
  scope       GoalScope
  userId      String?
  user        User?      @relation("UserGoals", fields: [userId], references: [id])
  teamId      String?
  team        Team?      @relation(fields: [teamId], references: [id])
  period      DateTime
  metric      GoalMetric
  target      Decimal    @db.Decimal(14, 2)
  currency    Currency?
  createdById String
  createdBy   User       @relation("GoalsCreated", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@unique([scope, userId, teamId, period, metric, currency])
  @@index([period])
  @@index([userId])
  @@index([teamId])
  @@map("goals")
  @@schema("propyte_crm")
}

// =====================================================================
// JOURNEY CANVAS LAYOUT — §C.2-i1
// =====================================================================

model JourneyLayout {
  id        String   @id // scope: "general" | "targeted:<CAMPAIGN>"
  positions Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("journey_layouts")
  @@schema("propyte_crm")
}

enum CommentPlatform {
  INSTAGRAM
  FACEBOOK

  @@schema("propyte_crm")
}

enum CommentActionStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@schema("propyte_crm")
}

model CommentRule {
  id             String   @id @default(uuid())
  name           String
  connectorId    String
  isActive       Boolean  @default(false)
  priority       Int      @default(100)
  phrases        String[]
  // Negativas: si alguna aparece en el comentario la regla NO dispara.
  excludePhrases String[] @default([])
  // Tope de actuaciones de la regla en una ventana deslizante de 24 h.
  dailyCap       Int      @default(200)
  publicReplies  String[]
  dmTemplate     String   @db.Text
  postFilter     String[] @default([])

  connector LeadConnector    @relation(fields: [connectorId], references: [id])
  logs      CommentRuleLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([connectorId, name])
  @@index([connectorId, isActive, priority])
  @@map("comment_rules")
  @@schema("propyte_crm")
}

model CommentRuleLog {
  id                  String              @id @default(uuid())
  ruleId              String?
  connectorId         String
  platform            CommentPlatform
  externalCommentId   String              @unique
  postId              String
  authorId            String
  authorHandle        String?
  commentText         String              @db.Text
  matchedPhrase       String
  publicReplyStatus   CommentActionStatus @default(PENDING)
  publicReplyError    String?
  publicReplyId       String?
  publicText          String?             @db.Text
  dmStatus            CommentActionStatus @default(PENDING)
  dmError             String?
  dmText              String?             @db.Text
  dmRecipientId       String?
  dmExternalMessageId String?
  contactId           String?

  rule    CommentRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  contact Contact?     @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())

  @@index([connectorId, postId, authorId])
  @@index([dmRecipientId])
  @@index([ruleId, createdAt])
  @@index([ruleId, publicReplyStatus])
  @@index([createdAt])
  @@map("comment_rule_logs")
  @@schema("propyte_crm")
}

/// Remitentes bloqueados al marcar una conversación como spam desde el Inbox.
/// Una fila por remitente: desbloquear y volver a bloquear reutiliza la fila
/// (unblockedAt vuelve a null) en vez de duplicarla.
/// Migración: prisma/migrations-manual/2026-08-05-blocked-senders.sql (aplicada 2026-08-05).
model BlockedSender {
  id          String         @id @default(uuid())
  channel     MessageChannel
  identifier  String
  reason      String?
  blockedById String?
  contactId   String?

  /// Estado del bloqueo en Meta: la limpieza del CRM va en transacción, esto es
  /// best-effort y reintentable (mismo patrón que CommentRuleLog.dmStatus).
  metaBlockStatus CommentActionStatus @default(PENDING)
  metaSpamStatus  CommentActionStatus @default(PENDING)
  metaError       String?

  createdAt   DateTime  @default(now())
  unblockedAt DateTime?

  blockedBy User?    @relation("SendersBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([channel, identifier])
  @@index([unblockedAt])
  @@index([contactId])
  @@index([createdAt])
  @@map("blocked_senders")
  @@schema("propyte_crm")
}

// =====================================================================
// MODERADOR DE PERMISOS — ver docs/superpowers/specs/2026-08-17-moderador-permisos-design.md
// =====================================================================

/// Default de permisos por rol. Presencia de la fila = concedido.
/// ADMIN nunca aparece aquí: es comodín en resolvePermission().
/// Los permisos sensibles tampoco: solo se conceden por persona.
model RolePermission {
  id         String   @id @default(uuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@map("role_permissions")
  @@schema("propyte_crm")
}

/// Excepción por persona. `granted` de dos estados: true concede aunque su
/// rol no lo tenga, false revoca aunque sí. El false es lo que permite darle
/// un permiso a un rol y quitárselo a una cuenta concreta (p.ej. una pantalla).
model UserPermissionOverride {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean
  /// Por qué. Obligatorio si el permiso es sensible (lo valida el server action).
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@map("user_permission_overrides")
  @@schema("propyte_crm")
}

// #872 (2026-10-14) — Desarrolladores: empresas inmobiliarias y otros aliados. Tabla propia del
// CRM que arranca VACÍA y se llena a mano desde el módulo /desarrolladores; NO es un espejo de
// real_estate_hub."Propyte_desarrolladores". `createdById` va sin relación a propósito: así el
// modelo User (compartido con el Hub) no cambia. Migración: prisma/migrations-manual/
// 2026-10-14-developer-partners.sql, aplicada ANTES de desplegar.
model DeveloperPartner {
  id          String    @id @default(uuid())
  name        String
  website     String?
  email       String?
  phone       String?
  // #949: tipo de empresa (DESARROLLADORA, INMOBILIARIA, PROVEEDOR…). Texto y no enum para poder
  // agregar tipos sin migración; la lista válida vive en src/lib/developer-partners/shared.ts.
  type        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  contacts    Contact[] // #949

  @@index([name])
  @@index([type])
  @@map("developer_partners")
  @@schema("propyte_crm")
}

// =====================================================================
// FICHAS TÉCNICAS COMPARTIBLES — #887
// =====================================================================

enum FichaTipo {
  DESARROLLO
  UNIDAD

  @@schema("propyte_crm")
}

// Enlace público /f/{token} de la ficha técnica de un desarrollo o una unidad del Hub, ligado
// al asesor que la compartió. El enlace se reenvía tal cual, así que quien lo abra —cliente,
// broker o el reenvío del reenvío— ve siempre el contacto de `createdBy`.
// No guarda copia de los datos: la ficha se arma al abrirla desde el catálogo publicado, para
// que precio y disponibilidad no se queden viejos.
model FichaCompartida {
  id               String    @id @default(uuid())
  token            String    @unique
  // Una ficha por asesor y por desarrollo/unidad: "<userId>:<developmentId>:<unitId|->".
  // Compartir dos veces lo mismo devuelve el MISMO enlace.
  clave            String    @unique
  tipo             FichaTipo
  hubDevelopmentId String
  hubUnitId        String?
  createdById      String
  createdBy        User      @relation("FichasCompartidas", fields: [createdById], references: [id])
  aperturas        Int       @default(0)
  ultimaApertura   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([createdById])
  @@map("fichas_compartidas")
  @@schema("propyte_crm")
}

// #917 — Archivos subidos a la ficha del contacto (hoy solo CV). El archivo vive en el bucket
// privado `crm-attachments` (storagePath); aquí, el nombre original y quién lo subió.
// Borrado lógico: deletedAt/deletedById (el objeto del bucket sí se borra).
model ContactFile {
  id           String    @id @default(uuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind         String    @default("CV")
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String    @unique
  uploadedById String
  uploadedBy   User      @relation("ContactFilesUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?

  @@index([contactId, kind])
  @@map("contact_files")
  @@schema("propyte_crm")
}

// =====================================================================
// RECLUTAMIENTO — #926 (Desempeño)
// Personas en proceso de contratación. Datos personales (LFPDPPP): solo ADMIN, DIRECTOR y
// GERENTE (src/lib/reclutamiento/roles.ts). Migración manual 2026-10-23-reclutamiento.sql.
// createdById/uploadedById sin relación a User a propósito: no se toca propyte_crm.users.
// =====================================================================

model RecruitCandidate {
  id             String                 @id @default(uuid())
  fullName       String
  age            Int?
  email          String?
  phone          String?
  area           String?
  /// Ubicación de trabajo o modalidad: PDC | MERIDA | TULUM | CANCUN | REMOTO | FORANEO (#927).
  /// TEXT, no el enum Plaza: Cancún, Remoto y Foráneo no son plazas del CRM.
  plaza          String?
  portfolioUrl   String?
  notes          String?
  /// Código de etapa: ver ETAPAS en src/lib/reclutamiento/shared.ts
  stage          String                 @default("RECIBIDO")
  stageChangedAt DateTime               @default(now())
  /// MANUAL | CHAT — por dónde llegó (CHAT queda listo para la ingesta desde el inbox)
  source         String                 @default("MANUAL")
  sourceRef      String?
  /// Contacto del CRM cuando el candidato llegó por el bot (spec 2026-11-02). Único: un contacto, un candidato.
  contactId         String?   @unique
  /// Canal por el que habló con el bot (ConversationChannel como texto: WHATSAPP | INSTAGRAM | MESSENGER).
  botCanal          String?
  /// Veredicto del bot: APTO | REVISAR | NO_APTO. null = aún no evaluado.
  botResultado      String?
  botPuntaje        Int?
  /// filtro:<clave> | ambiguo:<claves> | puntaje | null
  botMotivo         String?
  /// Respuestas del guion (copia de Contact.custom.reclutamiento_* al evaluar).
  botRespuestas     Json?
  /// Resultado de cada filtro eliminatorio: PASA | AMBIGUO | FALLA.
  botFiltros        Json?
  /// Puntos por criterio, incluida la actitud y sus razones.
  botDesglose       Json?
  /// Resumen de 2-3 líneas para el gerente, generado por IA.
  botResumen        String?
  botEvaluadoAt     DateTime?
  /// Días y horario que el candidato dijo que le acomodan para la entrevista (texto libre).
  horarioEntrevista String?
  /// CV como enlace (Drive, Dropbox…) cuando el canal no manda archivos (Instagram). Cuenta como CV recibido.
  cvUrl             String?
  /// #959: etapa en que estaba cuando el disparador la descartó porque su contacto dejó de ser
  /// Empleo; si vuelve a ser Empleo, regresa ahí. Un cambio de etapa desde la pantalla la limpia.
  stagePrevia       String?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  files          RecruitCandidateFile[]

  @@index([stage])
  @@index([createdAt])
  @@map("recruit_candidates")
  @@schema("propyte_crm")
}

model RecruitCandidateFile {
  id           String           @id @default(uuid())
  candidateId  String
  candidate    RecruitCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind         String           @default("CV")
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String           @unique
  /// MANUAL | CHAT. Con CHAT, sourceRef = id del mensaje (índice único parcial en SQL).
  source       String           @default("MANUAL")
  sourceRef    String?
  /// null cuando lo registra un proceso automático (ingesta desde chats)
  uploadedById String?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  deletedById  String?

  @@index([candidateId, kind])
  @@map("recruit_candidate_files")
  @@schema("propyte_crm")
}

// =====================================================================
// CATÁLOGOS DE CONTACTO — #936 etiquetas, #937 campañas y eventos (2026-10-30)
// =====================================================================
// Migración: prisma/migrations-manual/2026-10-30-catalogos-contacto.sql, ANTES de desplegar.
// `nameKey` = nombre sin acentos, en minúsculas y con espacios colapsados (src/lib/catalogos/
// clave.ts): único, para que no haya dos variantes de lo mismo. `createdById` sin relación a
// propósito, como developer_partners: así el modelo User (compartido con el Hub) no cambia.

// Etiquetas que se pueden elegir en un contacto. Contact.tags sigue guardando los NOMBRES.
model ContactTag {
  id          String    @id @default(uuid())
  name        String
  nameKey     String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  @@map("contact_tags")
  @@schema("propyte_crm")
}

// «Detalle de la fuente»: campañas y eventos de donde vienen los contactos.
model LeadCampaign {
  id          String    @id @default(uuid())
  name        String
  nameKey     String    @unique
  /// CAMPANA | EVENTO (TIPOS_CAMPANA en src/lib/catalogos/clave.ts; TEXT para poder agregar)
  kind        String
  createdById String?
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?
  contacts    Contact[]

  @@index([kind])
  @@map("lead_campaigns")
  @@schema("propyte_crm")
}
