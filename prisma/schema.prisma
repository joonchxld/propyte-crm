// =====================================================================
// PROPYTE CRM — Modelo de datos completo
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["propyte_crm"]
}

// =====================================================================
// ENUMS
// =====================================================================

// Roles de usuario para RBAC
enum UserRole {
  ADMIN
  ASESOR
  BROKER
  MANTENIMIENTO
  // Legacy roles (mantener por compatibilidad hasta migración completa)
  DIRECTOR
  GERENTE
  TEAM_LEADER
  ASESOR_SR
  ASESOR_JR
  HOSTESS
  MARKETING
  DEVELOPER_EXT

  @@schema("propyte_crm")
}

// Nivel en plan de carrera
enum CareerLevel {
  JR
  SR
  TOP_PRODUCER
  TEAM_LEADER
  GERENTE

  @@schema("propyte_crm")
}

// Plazas activas
enum Plaza {
  PDC
  TULUM
  MERIDA

  @@schema("propyte_crm")
}

// Tipo de contacto
enum ContactType {
  LEAD
  PROSPECTO
  CLIENTE
  INVERSIONISTA
  BROKER_EXTERNO
  REFERIDO
  EMPLEO
  COMPRADOR
  // Retirado (#907, 2026-10-19): ya no se ofrece ni se acepta como entrada — el que refiere
  // es el broker (BROKER_EXTERNO). Se queda en el enum porque Postgres no deja quitar un
  // valor sin recrear el tipo. Ver CONTACT_TYPE_RETIRADOS en src/lib/constants.ts.
  REFERIDOR
  // #907: tipos nuevos. Migración: prisma/migrations-manual/2026-10-19-broker-referidos.sql.
  PROVEEDOR
  OTRO
  // #938 (2026-10-29): LEAD, COMPRADOR e INVERSIONISTA se retiran y se juntan en LEAD_COMPRADOR;
  // entran LEAD_VENDEDOR y los dos referidos. Los retirados se quedan arriba por la misma razón
  // que REFERIDOR. Migración: prisma/migrations-manual/2026-10-29-tipos-lead-comprador.sql.
  LEAD_COMPRADOR
  LEAD_VENDEDOR
  REFERIDO_DE_BROKER
  REFERIDO_DE_CLIENTE

  @@schema("propyte_crm")
}

