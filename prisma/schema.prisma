// Operaciones / Pipeline de ventas
model Deal {
  id            String       @id @default(uuid())
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id])
  assignedToId  String
  assignedTo    User         @relation("AssignedDeals", fields: [assignedToId], references: [id])
  developmentId String?
  development   Development? @relation(fields: [developmentId], references: [id])
  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id])

  // Pipeline
  stage             DealStage @default(NEW_LEAD)
  // #957: la operación. etapa NULL = negocio de antes del #957 (anterior al apartado, lo mueve la #958).
  tipoOperacion        TipoOperacion?
  etapa                EtapaOperacion?
  subestado            String? // CHECK en la base: de la etapa
  reapartados          Int             @default(0)
  formaPago            FormaPago? // F5: contado (V1), crédito bancario (V2), financiamiento directo (V3)
  contratoFirmado      Boolean         @default(false)
  enganchePagado       Boolean         @default(false)
  vigenciaHasta        DateTime?       @db.Date // exclusiva (F1), contrato MB (F3), convenio (F6, F7)
  porcentajeComision   Decimal?        @db.Decimal(5, 2)
  nivelMb              String? // MB1 · MB2 · MB3 (F3)
  propiedadDescripcion String? // F1: la propiedad que se comercializa
  dealType          DealType
  // #948: flujo de ESTE negocio (F1–F8). Al crearse, si viene vacío, un disparador pone F5 si es
  // Nativa y si no el flujo del contacto. Se puede cambiar después (ver src/lib/flujos.ts).
  flujo             Flujo?
  estimatedValue    Decimal   @db.Decimal(14, 2)
  currency          Currency  @default(MXN)
  probability       Int       @default(5)
  expectedCloseDate DateTime
  actualCloseDate   DateTime?

  // Pérdida
  lostReason       LostReason?
  lostReasonDetail String?

  // Comisiones calculadas
  commissionTotal     Decimal?         @db.Decimal(14, 2)
  commissionAdvisor   Decimal?         @db.Decimal(14, 2)
  commissionTL        Decimal?         @db.Decimal(14, 2)
  commissionGerente   Decimal?         @db.Decimal(14, 2)
  commissionDirector  Decimal?         @db.Decimal(14, 2)
  commissionBrokerExt Decimal?         @db.Decimal(14, 2)
  commissionStatus    CommissionStatus @default(PENDIENTE)

  // Atribución
  leadSourceAtDeal String

  // Trazabilidad de migración Zoho (cutover Fase E, consolidado §3.6) — idempotencia + reconciliación
  zohoId String? @unique

  // Referencias al catálogo del Hub (Fase 7 las vuelve obligatorias; aquí preparan el terreno)
  hubDevelopmentId String?
  hubUnitId        String?
  holdId           String?
  holdExpiresAt    DateTime?

  // Fechas hito (paridad Zoho, consolidado §2.3.8)
  reservedAt       DateTime?
  contractSignedAt DateTime?
  deedAt           DateTime?
  deliveredAt      DateTime?

  // Campos custom metadata-driven (speckit Personalizacion 3.4)
  custom Json @default("{}")

  // Broker externo asociado (F6, §2.3.7)
  externalBrokerId String?
  externalBroker   ExternalBroker? @relation(fields: [externalBrokerId], references: [id])

  // Relaciones
  activities       Activity[]
  slaTimers        SlaTimer[]
  quotes           Quote[]
  documents        DealDocument[]
  conversionEvents ConversionEvent[]
  shortlists       Shortlist[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([etapa])
  @@map("deals")
  @@schema("propyte_crm")
}

// Actividades e interacciones
model Activity {
  id               String         @id @default(uuid())
  contactId        String?
  contact          Contact?       @relation(fields: [contactId], references: [id])
  dealId           String?
  deal             Deal?          @relation(fields: [dealId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  activityType     ActivityType
  subject          String
  description      String?        @db.Text
  dueDate          DateTime?
  completedAt      DateTime?
  // Agenda/Tareas (HUB #841): quién completó y archivado. FKs lógicas a users (constraints en
  // la migración SQL, sin Prisma relations para no expandir User). "Eliminar todo" en la Agenda
  // archiva (archivedAt) en vez de borrar: el asesor deja de verlas, los reportes de admin no.
  completedById    String?
  // #915: quién creó la actividad cuando no es su dueño (una tarea que un líder, gerente,
  // director o admin le asigna a un asesor). `userId` es el asignado. NULL en todas las filas
  // anteriores y cuando el creador es el mismo dueño. FK lógica a users, como completedById
  // (constraint en prisma/migrations-manual/2026-10-21-activities-created-by.sql).
  createdById      String?
  archivedAt       DateTime?
  archivedById     String?
  status           ActivityStatus @default(PENDIENTE)
  outcome          String?
  duration_minutes Int?
  // Duración exacta de la llamada en segundos, tal como la reporta Twilio (CallDuration /
  // DialCallDuration). duration_minutes sigue llenándose (redondeado hacia arriba) para reportes
  // y el formulario. NULL en filas anteriores y en actividades que no son llamadas de Twilio.
  // Migración: prisma/migrations-manual/2026-10-28-activity-duration-seconds.sql
  duration_seconds Int?
  // HUB #860: una NOTE escrita sobre una reunión o llamada de la Agenda apunta a ella. FK lógica a
  // activities(id) ON DELETE SET NULL e índice parcial (WHERE "parentActivityId" IS NOT NULL) en la
  // migración SQL agenda_notas_de_citas_parent_activity; sin relation de Prisma, como completedById.
  parentActivityId String?

  // Trazabilidad Google Workspace (GW-1 Gmail / GW-2 Calendar). FKs lógicas a Gmail/Calendar — no Prisma relations.
  gmailThreadId  String?
  gmailMessageId String? @unique // dedup de mensajes Gmail (un Activity por messageId)
  googleEventId  String? @unique // reservado GW-2 Calendar

  // Twilio Voice (click-to-call §5.11). Índice parcial en SQL manual (WHERE callSid IS NOT NULL).
  callSid      String? @unique
  recordingUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([gmailThreadId])
  @@index([userId, status, archivedAt])
  // Lead scoring: señales por contacto en una ventana de días.
  @@index([contactId, createdAt])
  @@map("activities")
  @@schema("propyte_crm")
}

// Hilo de Gmail ligero (GW-1): headers + snippet en DB; cuerpo on-demand vía Gmail API (speckit §2.6).
// contactId/dealId/userId son FKs lógicas (constraints en el SQL manual) — sin Prisma relations para
// no expandir Contact/Deal/User. Se consulta por (userId, threadId) y por contactId.
model GmailThread {
  id            String   @id @default(uuid())
  contactId     String
  dealId        String?
  userId        String
  threadId      String // Gmail threadId del asesor dueño del token
  messageCount  Int      @default(1)
  subject       String?
  lastMessageAt DateTime
  direction     String // INBOUND | OUTBOUND | MIXED
  snippet       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, threadId])
  @@index([contactId])
  @@map("gmail_threads")
  @@schema("propyte_crm")
}

// Reglas de comisión configurables
model CommissionRule {
