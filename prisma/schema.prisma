// =====================================================================
// MODELOS
// =====================================================================

// Usuarios del CRM
model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  role          UserRole
  careerLevel   CareerLevel @default(JR)
  plaza         Plaza
  teamLeaderId  String?
  teamLeader    User?       @relation("TeamMembers", fields: [teamLeaderId], references: [id])
  teamMembers   User[]      @relation("TeamMembers")
  sedetusNumber String?
  sedetusExpiry DateTime?
  isActive      Boolean     @default(true)
  avatarUrl     String?
  phone         String?
  passwordHash  String
  // #699 — La columna YA EXISTE en la base desde antes de esta tarjeta; lo que faltaba era
  // declararla aquí. Es deriva de esquema de la que ya avisa la #720 (cambios aplicados a
  // mano sin registrar), y por eso el código no podía escribirla: el cliente generado no
  // sabía que existiera. Comprobado contra producción: timestamp(3), nullable, sin
  // default — idéntica a `otpExpiresAt` y `updatedAt`, así que `DateTime?` mapea exacto y
  // NO introduce una migración.
  passwordChangedAt DateTime?
  otpHash       String?
  otpExpiresAt  DateTime?

  // Relaciones
  assignedContacts Contact[]      @relation("AssignedContacts")
  deals            Deal[]         @relation("AssignedDeals")
  activities       Activity[]
  walkInsAsHostess WalkIn[]       @relation("HostessWalkIns")
  walkInsAsAdvisor WalkIn[]       @relation("AdvisorWalkIns")
  reservedUnits    Unit[]         @relation("ReservedByUser")
  auditLogs        AuditLog[]
  notifications    Notification[]
  messages         Message[]

  agentIdentities AgentDef[] @relation("AgentIdentity")

  // Relaciones personalizacion & equipos
  ledTeams             Team[]            @relation("TeamLeader")
  forecastTeams        Team[]            @relation("TeamForecast")
  teamMemberships      TeamMember[]
  territoryMemberships TerritoryMember[]
  forecastTerritories  Territory[]       @relation("TerritoryForecast")

  // Relaciones rebuild F1/F6
  quotesCreated           Quote[]           @relation("QuotesCreated")
  dealDocsUploaded        DealDocument[]    @relation("DealDocsUploaded")
  profile                 UserProfile?
  templates               UserTemplate[]
  ownedActionPlans        ActionPlan[]      @relation("OwnedActionPlans")
  controlledConversations Conversation[]    @relation("ControlledConversations")
  googleOAuthToken        GoogleOAuthToken?
  shortlistsCreated       Shortlist[]       @relation("ShortlistsCreated")
  botConfigUpdates        BotConfig[]       @relation("BotConfigUpdatedBy")
  brandsMarketing         Brand[]           @relation("BrandMarketingOwner")
  // Marcas que ve (entrega 2, 2026-10-12). Relación solo de Prisma: vive en user_brand_access
  // y NO agrega columnas a users (el Hub comparte esa tabla, .claude/AI_TASKS.md).
  brandAccess             UserBrandAccess[]
  // WhatsApp propio del asesor (2026-10-14, coexistencia PR 2). Relaciones solo de Prisma: la
  // columna vive en lead_connectors."ownerUserId" y la tabla de posibles prospectos es aparte;
  // users NO cambia (el Hub la comparte).
  ownedWhatsAppConnectors LeadConnector[]           @relation("LeadConnectorOwner")
  whatsappPendingProspects WhatsappPendingProspect[] @relation("PendingProspectOwner")

  // Metas/Scorecard (§5.14)
  goals        Goal[] @relation("UserGoals")
  goalsCreated Goal[] @relation("GoalsCreated")

  sendersBlocked BlockedSender[] @relation("SendersBlockedBy")

  // Moderador de permisos — fase 0
  permissionOverrides UserPermissionOverride[]

  // Fichas técnicas compartibles (#887). Relación solo de Prisma: la columna vive en
  // fichas_compartidas."createdById"; users NO cambia (el Hub la comparte).
  fichasCompartidas FichaCompartida[] @relation("FichasCompartidas")
  contactFilesUploaded ContactFile[] @relation("ContactFilesUploaded")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
  @@schema("propyte_crm")
}

// Contactos / Leads
model Contact {
  id                String            @id @default(uuid())
  firstName         String
  lastName          String
  email             String?
  phone             String
  secondaryPhone    String?
  // Sin default (#863, 2026-10-13): un contacto nuevo nace SIN tipo («—» en la UI) y lo
  // clasifica el asesor, o el clasificador del bot si la intención es explícita en el chat.
  // Antes era @default(COMPRADOR) y todo contacto parecía comprador sin que nadie lo
  // decidiera. Migración: prisma/migrations-manual/2026-10-13-contact-type-nullable.sql.
  contactType       ContactType?
  // #948: flujo con el que entró (F1–F8). NULL = «Sin flujo». Un disparador lo llena si está
  // vacío: Broker externo → F6, Empleo → F8 (ver src/lib/flujos.ts).
  flujo             Flujo?
  leadSource        LeadSource
  leadSourceDetail  String?
  residenceCity     String?
  residenceCountry  String?
  nationality       String?
  preferredLanguage PreferredLanguage @default(ES)

  // Perfil de inversión (del discovery call)
  investmentProfile InvestmentProfile?
  propertyType      PropertyType?
  purchaseTimeline  PurchaseTimeline?
  budgetMin         Decimal?           @db.Decimal(14, 2)
  budgetMax         Decimal?           @db.Decimal(14, 2)
  paymentMethod     PaymentMethod?
  preferredZone     String?
  purchaseModality  PurchaseModality?
  rentalStrategy    RentalStrategy?

  // Asignación y scoring
  assignedToId String?
  assignedTo   User?           @relation("AssignedContacts", fields: [assignedToId], references: [id])
  // #973: la calcula el CRM (lib/copilot/temperatura.ts, cron de workflows); el detalle —grupo A/B,
  // motivo, última respuesta— vive en contact_temperaturas. NULL = no aplica (Registrado por broker,
  // Derivado a RH).
  temperature  LeadTemperature? @default(COLD)
  score        Int             @default(0)
  tags         String[]

  // Campos custom metadata-driven (speckit Personalizacion 3.4)
  custom Json @default("{}")

  // Ciclo de contacto y cumplimiento (Anexo Técnico §B.2)
  contactStatus     ContactStatus   @default(NUEVO)
  // #953: estado del flujograma v0.2. NULL = «Por clasificar» (lo mueve la entrega 3). El subestado
  // depende del estado (CHECK en la base). Las salidas llevan razón en vez de subestado.
  estado             EstadoContacto? @default(NUEVO)
  subestado          String?
  razonSalida        RazonSalida?
  razonSalidaDetalle String?
  fechaRecontacto    DateTime?       @db.Date
  etapaPrevia        EstadoContacto? // la pone el disparador al entrar a una salida
  reactivaciones     Int             @default(0)
  ticketEstimado     Decimal?        @db.Decimal(14, 2)
  ticketMoneda       Currency        @default(MXN)
  lifecycleStage    LifecycleStage?
  targetPlaza       Plaza?          // reparto por plaza — lib/intake/campaign-plaza.ts
  urgency           Urgency?
  lastActivityAt    DateTime?
  originalCreatedAt DateTime?
  doNotContact      Boolean         @default(false)
  whatsappOptOut    Boolean         @default(false)
  recordingConsent  Boolean         @default(false)
  zohoId            String?         @unique
  hubContactId      String?
  instagramId       String?         @unique
  messengerPsid     String?         @unique
  // BSUID de WhatsApp (`contacts[].user_id`). Meta lo manda en TODOS los webhooks
  // entrantes desde abril de 2026; el teléfono (`wa_id`) es condicional —solo llega
  // dentro de la ventana de 30 días, que se evalúa POR NÚMERO DE NEGOCIO—. Mismo
  // patrón que instagramId/messengerPsid. Formato: país ISO alpha-2 + punto + hasta
  // 128 alfanuméricos (US.13491208655302741918); se guarda ÍNTEGRO, recortarlo hace
  // fallar el envío. Hoy solo se persiste: el emparejado sigue yendo por teléfono.
  whatsappUserId    String?         @unique

  // Dedup / merge (confirmación humana salvo phone+email idénticos — Anexo B §K G.6)
  mergedIntoId String?
  mergedInto   Contact?  @relation("MergedContacts", fields: [mergedIntoId], references: [id])
  mergedFrom   Contact[] @relation("MergedContacts")

  // Broker que trajo a este contacto (#907). Solo puede apuntar a un contacto de tipo
  // BROKER_EXTERNO (lo valida /api/contacts); si el broker se borra de verdad, la liga se
  // suelta (SET NULL) y el referido se queda. La ficha del broker lista sus `referrals`.
  referredById String?
  referredBy   Contact?  @relation("ContactReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    Contact[] @relation("ContactReferrals")
  // #917: archivos subidos a la ficha (CV).
  files        ContactFile[]

  // #949: empresa a la que pertenece (módulo «Empresas», tabla developer_partners). N:1. Si la
  // empresa se borra de verdad, la liga se suelta (SET NULL). No confundir con `company`, el
  // texto libre que vino de Zoho (#914), que se queda como histórico.
  developerPartnerId String?
  developerPartner   DeveloperPartner? @relation(fields: [developerPartnerId], references: [id], onDelete: SetNull)
  // #937: campaña o evento de donde vino (catálogo lead_campaigns). `leadSourceDetail` sigue
  // siendo el detalle técnico que escriben las entradas automáticas («comentario:<id>»).
  campaignId         String?
  campaign           LeadCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Información adicional (#914). Nacieron para la migración de los leads de Zoho, pero son
  // campos normales del contacto: se editan en la ficha y se gatean por rol como los demás.
  // Lista única con etiquetas y validación: src/lib/contacts/campos-adicionales.ts.
  // Migración: prisma/migrations-manual/2026-10-20-columnas-migracion-zoho.sql.
  company         String? // empresa o inmobiliaria (de los brokers, sobre todo)
  secondaryEmail  String?
  facebook        String?
  instagramHandle String? // usuario de Instagram; instagramId es el id de Meta, otra cosa
  budgetText      String? // presupuesto tal como lo dijo el contacto («$150,000 – $300,000 USD»)
  brokerInterest  String? // «Interés de Broker» de Zoho
  initialMessage  String? // el mensaje con el que llegó
  internalStage   String? // «Etapa interna» de Zoho
  discardReason   String?
  appliedPosition String? // puesto solicitado (contactos de Empleo)
  inSequence      Boolean? // «En secuencia» de la automatización de Zoho (histórico)

  // Relaciones
  deals       Deal[]
  activities  Activity[]
  walkIns     WalkIn[]
  units       Unit[]           @relation("ReservedByContact")
  messages    Message[]
  commentLogs CommentRuleLog[]
  blockedSenders BlockedSender[]

  // Relaciones rebuild F1
  dossier          ContactDossier?
  conversionEvents ConversionEvent[]
  adAttribution    AdAttribution?
  webBehavior      WebBehavior?
  conversations    Conversation[]
  slaTimers        SlaTimer[]
  connectorLeads   ConnectorLeadLog[]
  shortlists       Shortlist[]
  brands           ContactBrand[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([referredById])
  @@index([flujo])
  @@index([estado])
  @@index([developerPartnerId])
  @@index([campaignId])
  @@map("contacts")
  @@schema("propyte_crm")
}

// Desarrollos inmobiliarios
model Development {
