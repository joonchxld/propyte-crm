  cadenciaId      String?
  respuestaAt     DateTime
  estadoAntes     String?
  subestadoAntes  String?
  resultado       String? // NULL = pendiente; ver src/lib/copilot/clasificacion.ts
  fechaRecontacto DateTime? @db.Date
  resueltaAt      DateTime?
  resueltaPorId   String?
