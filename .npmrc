# Layout plano de node_modules (estilo npm) en vez del arbol de symlinks de pnpm.
#
# Motivo: pnpm 10 dejo de ejecutar los build scripts de dependencias por defecto
# ("Ignored build scripts: @prisma/client, @prisma/engines, prisma, sharp, esbuild").
# Con el layout por defecto, `prisma generate` deja el cliente generado solo dentro de
# node_modules/.pnpm/@prisma+client@X/node_modules/.prisma/, alcanzable unicamente si se
# dereferencia el symlink. El runtime de LiteSpeed/lsnode en Hostinger no lo dereferencia
# y la app truena en cada ruta que importa Prisma con:
#
#   Error: Cannot find module '.prisma/client/default'
#
# (produccion caida del 2026-09-11 al 2026-09-14; /login vivo y todo lo demas en 500).
#
# Con node_modules plano, `prisma generate` escribe node_modules/.prisma/ en el top-level,
# que resuelve con o sin dereferencia de symlinks.
#
# Desde 2026-11 producción corre en el VPS (Node directo en Docker), que sí sigue los symlinks;
# se deja `hoisted` para no cambiar un layout que ya está probado en producción y en la CI.
node-linker=hoisted

# next-auth@4.24.15 declara nodemailer como peer OPCIONAL fijado a "^7.0.7" (solo lo usa
# su EmailProvider, que este proyecto no configura — ver src/lib/email/mailer.ts, que es
# nuestro propio wrapper sobre nodemailer, no el de next-auth). npm 7+ igual bloquea la
# instalacion con ERESOLVE por ese peer no satisfecho aunque sea opcional y no se use.
# Sin esto, `npm install`/`npm ci` truenan tras el fix de seguridad del #814
# (nodemailer 7->10).
legacy-peer-deps=true
