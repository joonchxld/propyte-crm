  @@map("copilot_cadencia_defs")
  @@schema("propyte_crm")
}

model CopilotCadenciaPaso {
  id          String   @id @default(uuid())
  tipo        String
  codigo      String
  canal       String
  offset      Int
  unidad      String // DIA | MIN
  ancla       String   @default("CADENCIA") // CADENCIA | FECHA_RECONTACTO
