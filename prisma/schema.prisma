  @@schema("propyte_crm")
}

model GoogleOAuthToken {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken    String    @db.Text // cifrado AES-256-GCM
