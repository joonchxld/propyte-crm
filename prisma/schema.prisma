  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  channel    TemplateChannel
  name       String
  shortcut   String?
  subject    String?
  body       String            @db.Text
  language   PreferredLanguage @default(ES)
  isActive   Boolean           @default(true)
  usageCount Int               @default(0)

  createdAt DateTime  @default(now())
