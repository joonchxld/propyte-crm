// =====================================================================
// REBUILD F1 — Contacto extendido (Anexo Técnico §B.3-B.5)
// =====================================================================

// Expediente KYC (PII sensible: documentNumber/taxId se guardan CIFRADOS con lib/crypto)
model ContactDossier {
  id        String  @id @default(uuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id])

  documentType   DocumentType?
  documentNumber String? // cifrado AES-256-GCM (lib/crypto), nunca en logs ni payloads de IA
  birthDate      DateTime?
  birthPlace     String?
  maritalStatus  MaritalStatus?
  occupation     String?
  taxId          String? // cifrado AES-256-GCM
  taxRegime      TaxRegime?

  // Domicilio de correspondencia
  corrStreet  String?
  corrColonia String?
  corrCity    String?
  corrState   String?
  corrZip     String?
  corrCountry String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("contact_dossiers")
  @@schema("propyte_crm")
}

// Atribución publicitaria (1:1 con Contact; la pueblan los conectores y el webhook web)
model AdAttribution {
  id        String  @id @default(uuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id])

  gclid        String?
  fbclid       String?
  ttclid       String? // TikTok click id
  liFatId      String? // LinkedIn first-party ad tracking id
  portalLeadId String? // id del lead en el portal inmobiliario
  socialLeadId String? // Meta leadgen_id / TikTok lead id

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  campaignName String?
  adName       String?
  adsetName    String?
  // #914: ids de Meta y formulario (los trae la migración de Zoho; Lead Ads también los da).
  metaCampaignId String?
  metaAdsetId    String?
  metaAdId       String?
  metaFormId     String?
  formName       String?
  network      String?
  device       String?
  keyword      String?

  costPerClick      Decimal? @db.Decimal(10, 2)
  costPerConversion Decimal? @db.Decimal(10, 2)

  conversionExportStatus String?
  conversionExportedAt   DateTime?

  landingPage String?
  referrer    String?
  firstTouch  DateTime?
  lastTouch   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ad_attributions")
  @@schema("propyte_crm")
}

// Lead scoring en modo sombra (spec 2026-10-26-lead-scoring-design.md). Tabla aparte y SIN
// relación a Contact a propósito: si se despliega antes de correr la migración, ninguna consulta
// de contactos cambia; solo falla (con guarda) el cálculo del score.
// `score` null = contacto excluido (broker, empleo…). Contact.score NO se toca hasta que
// SystemConfig `scoring.activo` sea true.
// Migración: prisma/migrations-manual/2026-10-26-lead-scoring.sql
// #973 — Temperatura calculada (Copilot). Una fila por contacto, la reescribe el cron de workflows.
// contacts.temperature es la que ve el asesor; aquí está el porqué y lo que ordena «Mi día».
model ContactTemperatura {
  contactId         String           @id
  temperatura       LeadTemperature? // NULL = no aplica
  grupo             String? // «A» | «B» dentro de Tibio (no se muestra al asesor)
  orden             Int // 0 = primero en «Mi día»
  motivo            String
  ultimaRespuestaAt DateTime?
  senalCompraAt     DateTime?
  calculadoAt       DateTime         @default(now())

  @@index([calculadoAt])
  @@map("contact_temperaturas")
  @@schema("propyte_crm")
}

// #988 — Copilot «Mi día»: cadencia de nuevos (15 días, PDF de Luis). Tablas, disparador de
// inscripción y plantillas en prisma/migrations-manual/2026-11-05-copilot-mi-dia.sql. Reglas en
// src/lib/copilot/cadencia-nuevos.ts. Sin relations de Prisma, como contact_temperaturas.
model CopilotPlantilla {
  id          String   @id @default(uuid())
  codigo      String // WA1, CORREO1, SMS_C2, BUZON1, LINEA_VALOR, CIFRA…
  idioma      String // ES | EN
  variante    String   @default("") // TRACCION/METODO, FIDEICOMISO/SEGURIDAD, A–D, PDC/CANCUN/QROO
  canal       String // WHATSAPP | SMS | CORREO | BUZON | DATO
  nombre      String
  asunto      String?
  cuerpo      String
  orden       Int      @default(0)
  updatedAt   DateTime @default(now())
  updatedById String?

  @@unique([codigo, idioma, variante])
  @@map("copilot_plantillas")
  @@schema("propyte_crm")
}

model CopilotCadencia {
  id               String    @id @default(uuid())
  contactId        String
  tipo             String // copilot_cadencia_defs.tipo (#993): NUEVOS, BASE_DE_DATOS, AGENDAR, POSPUSO…
  estado           String    @default("ACTIVA") // ACTIVA | PAUSADA (esperando clasificar) | TERMINADA (una ACTIVA por contacto)
  motivoFin        String? // RESPONDIO | SALIO_DEL_ESTADO | YA_NO_APLICA | SIN_RESPUESTA | CITA_AGENDADA | CAMBIO_RAMA
  anclaAt          DateTime? // #993: desde dónde se cuentan los pasos (NULL en las de la #988 = inicio)
  anclaTipo        String?
  ignorarAntesDe   DateTime? // #993: «no era respuesta»: lo anterior no cuenta como respuesta
  origenId         String? // #993: la cadencia de la que viene
  inicio           DateTime
  diaInicio        DateTime  @db.Date // día 1, fecha civil de Cancún
  horaEntrada      Int // 0–23, Cancún: decide la franja de la L1
  modoSms          String? // EE. UU./Canadá: COMPLEMENTARIO | ROBUSTO (se decide el día 4)
  diaMaterializado Int       @default(0) // hasta qué día ya se crearon los toques
  primerIntentoAt  DateTime?
  respuestaAt      DateTime?
  finAt            DateTime?
  createdAt        DateTime  @default(now())

  @@index([contactId])
  @@index([estado])
  @@map("copilot_cadencias")
  @@schema("propyte_crm")
}

model CopilotToque {
  id             String    @id @default(uuid())
  cadenciaId     String
  contactId      String
  dia            Int
  fecha          DateTime  @db.Date
  codigo         String // L1…L7, WA1…WA5, CORREO1…CORREO5, SMS1…SMS4, BUZON1, BUZON2
  canal          String // LLAMADA | WHATSAPP | SMS | CORREO | BUZON
  orden          Int
  plantilla      String?
  cuando         String
  variante       String?
  resultado      String? // NULL = pendiente
  programadoAt   DateTime  @default(now()) // #993: cuándo toca (de ahí se cuentan las 24 h)
  expiraAt       DateTime?
  nota           String?
  resultadoAt    DateTime?
  resultadoPorId String?
  avisoVencidaAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([cadenciaId, codigo])
  @@index([contactId])
  @@map("copilot_toques")
  @@schema("propyte_crm")
}

// #993 — Módulo «Cadencias» (Desempeño): el catálogo que sigue Copilot. Migración
// prisma/migrations-manual/2026-11-09-cadencias-por-rama.sql; tipos y siembra en
// src/lib/copilot/cadencias-def.ts; evaluación en src/lib/copilot/motor.ts.
